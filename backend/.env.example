# Copie este arquivo para backend/.env e preencha no computador do professor.
# Não publique o arquivo .env.

ADMIN_PASSWORD=troque-esta-senha

# Destino fixo da avaliação. Pode manter este endereço.
SMTP_TO=diogo.nascimento@institutojef.org.br

# Peça ao provedor de e-mail do instituto os dados abaixo.
# Sem estes dados, as notas são salvas mesmo assim e o e-mail fica pendente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Use somente se a página pública ficar em outro endereço.
# Exemplo: https://usuario.github.io
CORS_ORIGIN=

HOST=0.0.0.0
PORT=8000
COOKIE_SECURE=false
